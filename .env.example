# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# PostgreSQL (docker compose up -d starts one locally)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auditdelta
# 64 hex chars, e.g. `openssl rand -hex 32`
TENANT_ENCRYPTION_KEY=

# Redis: either REDIS_URL, or REDIS_HOST/PORT/PASSWORD
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Salesforce OAuth (Connected App / External Client App)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:3000/auth/callback
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=68.0

# Shared secret sent by the Salesforce Named Credential as x-auditdelta-secret
AUDITDELTA_SECRET=

# AI: LLM_PROVIDER=gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Slack app (see slack/manifest.json). Single workspace: SIGNING_SECRET + BOT_TOKEN.
# Multi-workspace OAuth: SIGNING_SECRET + CLIENT_ID + CLIENT_SECRET (+ STATE_SECRET), install at /slack/install
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=
SLACK_WEBHOOK_URL=
AUDITDELTA_DASHBOARD_URL=

# Monitoring
POLLING_ENABLED=true
POLLING_INTERVAL_MINUTES=10

# Debugging (keep false in production)
ENABLE_DEBUG_ROUTES=false
# Writes full prompts (contain org metadata) to llm_prompts_log*
LLM_PROMPT_LOG=false
